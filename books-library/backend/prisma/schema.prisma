model Book {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  published DateTime
  genre     String?
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  books     Book[]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}